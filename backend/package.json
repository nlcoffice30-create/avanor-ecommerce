{
  "name": "avanor-backend",
  "version": "1.0.0",
  "description": "AVANOR E-commerce Backend - Express.js with PostgreSQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
