    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.1.1",
    "axios": "^1.6.0",
    "stripe": "^14.8.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "redis": "^4.6.11",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1522.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.4.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.0",
    "@types/jest": "^29.5.11",
